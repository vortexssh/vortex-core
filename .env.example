APP_NAME=VortexCore
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://vortex:vortex@localhost:5432/vortex_core

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Telemetry TTL in Redis (seconds)
TELEMETRY_TTL_SECONDS=60
