APP_NAME=VortexCore
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

POSTGRES_USER=vortex
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=vortex_core

DATABASE_URL=postgresql+asyncpg://vortex:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/vortex_core
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TELEMETRY_TTL_SECONDS=60
CORS_ORIGINS=https://api.vortex.timant32.ru

LOGIN_RATE_LIMIT_PER_MINUTE=20
AGENT_CONNECT_RATE_LIMIT_PER_MINUTE=60
AGENT_PRESENCE_TTL_SECONDS=90
WS_HEARTBEAT_INTERVAL_SECONDS=30

DOMAIN=api.vortex.timant32.ru
