APP_NAME=VortexCore
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

POSTGRES_USER=vortex
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=vortex_core

DATABASE_URL=postgresql+asyncpg://vortex:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/vortex_core
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TELEMETRY_TTL_SECONDS=60
CORS_ORIGINS=https://api.vortex.timant32.ru

LOGIN_RATE_LIMIT_PER_MINUTE=20
AGENT_CONNECT_RATE_LIMIT_PER_MINUTE=60
AGENT_PRESENCE_TTL_SECONDS=90
WS_HEARTBEAT_INTERVAL_SECONDS=30

DOMAIN=api.vortex.timant32.ru

# GeoIP — set MAXMIND_LICENSE_KEY for offline lookups (recommended in production)
GEOIP_ENABLED=true
GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb
GEOIP_HTTP_FALLBACK=true
MAXMIND_LICENSE_KEY=

FRANKFURTER_BASE_URL=https://api.frankfurter.app
TELEGRAM_BOT_TOKEN=
# Optional — if empty, Core calls getMe and caches the username
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_API_KEY=
TELEGRAM_LINK_TTL_MINUTES=10

# Email verification
WEB_APP_URL=https://vortex.timant32.ru
EMAIL_VERIFICATION_TTL_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vortex.timant32.ru
SMTP_USE_TLS=true
